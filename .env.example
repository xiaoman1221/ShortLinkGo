# ShortLinkGo 环境变量模板：复制为 .env 后按需修改
# cp .env.example .env

# 服务监听端口
PORT=8080

# Gin 运行模式（debug/release/test），默认 release；debug 仅用于本地开发
GIN_MODE=release

# SQLite 数据库文件路径
DB_PATH=data.db

# JWT 签名密钥（生产环境务必设置为高强度随机字符串并保持固定）
JWT_KEY=

# JWT 有效期（秒），默认 86400（24 小时）
JWT_EXPIRE=86400

# 可信代理（可选）：部署在 Nginx/CDN 之后时填写代理 IP/CIDR，逗号分隔，
# 如 TRUSTED_PROXIES=172.17.0.1/16,10.0.0.1；留空表示不信任任何代理头
TRUSTED_PROXIES=

# 站点对外地址，用于拼装短链接与找回密码链接，例如 https://s.example.com
HOST=

# 站点名称/Logo/简介（可选，不设置则使用默认名，Logo 可在后台“系统管理-网站信息”上传）
SITE_NAME=
SITE_LOGO=
SITE_DESC=

# GeoIP 数据库路径（可选）：放置 MaxMind GeoLite2-City.mmdb 后访问地图可按国家解析
GEO_DB_PATH=

# SMTP 邮件配置（可选，首次启动写入系统设置；也可在后台“设置”页配置）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
